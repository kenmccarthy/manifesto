# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# Logs and temp
*.log
.cache/

# Node (local dev/test tooling only — not part of the course build)
node_modules/
package.json
package-lock.json
_smoke.mjs

# Local environment / secrets (keep real credentials out of git)
.env
.env.local

# SCORM build output — ignore the unpacked package, but keep the uploadable
# .zip tracked so it's downloadable straight from the repo.
dist/*
!dist/manifesto-course-scorm12.zip
